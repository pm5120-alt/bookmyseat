DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Generate a URI-safe random hex password before using Docker Compose.
POSTGRES_PASSWORD=
TIME_ZONE=Asia/Kolkata
SEAT_HOLD_SECONDS=120
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional public Payment Configuration ID (config_...) from Razorpay Dashboard.
RAZORPAY_CONFIG_ID=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=tickets@example.com

PRIVATE_MEDIA_ROOT=./private-media
SECURE_SSL_REDIRECT=false
SECURE_HSTS_PRELOAD=false
